{
    "manifest_version": 3,
    "name": "AI Thumbnail Detector",
    "version": "0.1.0",
    "description": "Displays estimated AI likelihood scores on YouTube thumbnails.",
    "host_permissions": [
    "http://127.0.0.1/*"
    ],
    "background": {
      "service_worker": "scripts/background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://www.youtube.com/*"],
        "js": [
          "scripts/classifier.js",
          "scripts/content.js"
          ],
        "css": ["styles/content.css"]
      }
    ]
  }